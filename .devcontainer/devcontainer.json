{
    "name": "Promethea",
    "image": "mcr.microsoft.com/devcontainers/miniconda:1-3",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    // Default Codespaces machine: 2-core / 8 GB / 32 GB storage.
    // OpenMC + ENDF/B-VIII.0 (~4 GB) fits, but the MSRE benchmark
    // will be slow on 2 cores (~30-60 min). Upgrade to 4-core for
    // faster runs if your Codespaces quota allows.
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb",
        "storage": "32gb"
    },

    // Install OpenMC + scientific stack on container creation.
    // Cross-sections are fetched lazily by the user (see README).
    "postCreateCommand": "bash .devcontainer/post-create.sh",

    "remoteEnv": {
        "OPENMC_CROSS_SECTIONS": "/workspaces/promethea/data/xs/endfb-viii.0-hdf5/cross_sections.xml"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/envs/promethea/bin/python"
            }
        }
    }
}
